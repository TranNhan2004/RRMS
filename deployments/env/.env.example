# MySQL
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=YOUR_MYSQL_DATABASE
MYSQL_TIMEZONE=YOUR_MYSQL_TIMEZONE

# Redis
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Mailpit - only used in dev and test environments
MP_SMTP_AUTH=YOUR_MAILPIT_ADMIN_ACCOUNT:YOUR_MAILPIT_ADMIN_PASSWORD
MP_SMTP_AUTH_ALLOW_INSECURE=true

# RustFS
RUSTFS_ACCESS_KEY=YOUR_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=YOUR_RUSTFS_SECRET_KEY