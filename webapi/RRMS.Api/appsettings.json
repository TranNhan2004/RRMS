{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_MYSQL_CONNECTION_STRING"
  },
  "Redis": {
    "ConnectionString": "YOUR_REDIS_CONNECTION_STRING (string)"
  },
  "Auth": {
    "Credentials": {
      "VerificationUrl": "",
      "AccessToken": {
        "SecretKey": "",
        "Issuer": "rrms",
        "Audience": "rrms-api",
        "Expiration": "00:10:00"
      },
      "RefreshToken": {
        "SecretKey": "",
        "Issuer": "rrms",
        "Audience": "rrms-auth",
        "Expiration": "7.00:00:00"
      },
      "SecureCookies": true,
      "SameSite": "Lax",
      "RefreshCookiePath": "/api/v1/auth",
      "RegistrationVerificationTtl": "00:15:00",
      "RegistrationCompletionTtl": "00:10:00",
      "RoleSelectionTtl": "00:05:00",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "UserName": "",
        "Password": "",
        "From": "",
        "UseAuthentication": true,
        "RequireStartTls": true
      }
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "CallbackUrl": "",
      "RoleSelectionUrl": "",
      "AllowedOrigins": [],
      "RequestTtl": "00:05:00"
    }
  },
  "AuditLog": {
    "RetryCount": 3,
    "RetryDelayInMsSeconds": [
      1000,
      5000,
      10000
    ],
    "JitterFromMsSeconds": 1000,
    "JitterToMsSeconds": 3000
  },
  "Export": {
    "MaxQueueItems": 500
  },
  "ObjectStorage": {
    "Endpoint": "YOUR_OBJECT_STORAGE_ENDPOINT (string)",
    "BucketName": "YOUR_OBJECT_STORAGE_BUCKET_NAME (string)",
    "Region": "YOUR_OBJECT_STORAGE_REGION (string)",
    "AccessKey": "YOUR_OBJECT_STORAGE_ACCESS_KEY (string)",
    "SecretKey": "YOUR_OBJECT_STORAGE_SECRET_KEY (string)",
    "ForcePathStyle": true
  },
  "Database": {
    "ServerVersion": "8.0.36"
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "X-XSRF-TOKEN",
      "X-Client-Action-Id",
      "X-Client-Request-Id",
      "X-Request-Id"
    ],
    "AllowCredentials": true
  },
  "Csrf": {
    "SecretKey": "",
    "CookieName": "XSRF-TOKEN",
    "HeaderName": "X-XSRF-TOKEN"
  }
}
