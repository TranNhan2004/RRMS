{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "LocalBypassUserEmail": "YOUR_LOCAL_BYPASS_USER_EMAIL",
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=room-rental-ms;User ID=rrms;Password=YOUR_PASSWORD;Pooling=true;MinimumPoolSize=5;MaximumPoolSize=20;ConnectionIdleTimeout=180;ConnectionLifeTime=0;ConnectionTimeout=30;DefaultCommandTimeout=60;ConnectionReset=true;AllowPublicKeyRetrieval=false;SslMode=Preferred;",
    "Redis": "localhost:6379,password=YOUR_PASSWORD,defaultDatabase=0,abortConnect=false,connectTimeout=5000,syncTimeout=5000,asyncTimeout=5000,connectRetry=3,keepAlive=60,ssl=false"
  },
  "Auth": {
    "FrontendPath": "http://localhost:4200",
    "Credentials": {
      "VerificationUrl": "",
      "RegistrationVerificationTtl": "00:15:00",
      "RegistrationCompletionTtl": "00:10:00",
      "RoleSelectionTtl": "00:05:00"
    },
    "Google": {
      "ClientId": "YOUR_GG_CLIENT_ID (string)",
      "ClientSecret": "YOUR_GG_CLIENT_SECRET (string)"
    },
    "PendingSession": {
      "Cookie": {
        "Name": "pending-session"
      }
    },
    "Session": {
      "SlidingExpiration": "00:30:00",
      "AbsoluteExpiration": "1.00:00:00",
      "ExternalExpiration": "00:05:00",
      "Cookie": {
        "Name": "session"
      }
    }
  },
  "Csrf": {
    "HeaderName": "X-XSRF-TOKEN",
    "CookieTokenName": "antiforgery",
    "RequestTokenCookieName": "XSRF-TOKEN"
  },
  "Email": {
    "Host": "YOUR_EMAIL_HOST (string)",
    "Port": 587,
    "Username": "YOUR_EMAIL_USERNAME (string)",
    "Password": "YOUR_EMAIL_PASSWORD (string)",
    "DefaultFromEmail": "YOUR_EMAIL_DEFAULT_FROM_EMAIL (string)",
    "DefaultFromName": "YOUR_EMAIL_DEFAULT_FROM_NAME (string)",
    "UseSsl": false,
    "QueueCapacity": 100
  },
  "AuditLog": {
    "RetryCount": 3,
    "RetryDelayInMsSeconds": [1000, 5000, 10000],
    "JitterFromMsSeconds": 1000,
    "JitterToMsSeconds": 3000
  },
  "Export": {
    "MaxQueueItems": 500
  },
  "ObjectStorage": {
    "Endpoint": "YOUR_OBJECT_STORAGE_ENDPOINT (string)",
    "BucketName": "YOUR_OBJECT_STORAGE_BUCKET_NAME (string)",
    "Region": "YOUR_OBJECT_STORAGE_REGION (string)",
    "AccessKey": "YOUR_OBJECT_STORAGE_ACCESS_KEY (string)",
    "SecretKey": "YOUR_OBJECT_STORAGE_SECRET_KEY (string)",
    "ForcePathStyle": true
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"],
    "AllowedMethods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "X-XSRF-TOKEN",
      "X-Client-Action-Id",
      "X-Client-Request-Id",
      "X-Request-Id",
      "X-Forwarded-For",
      "X-Forwarded-Proto"
    ],
    "AllowCredentials": true
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiter": {
    "Auth": {
      "PermitLimit": 20,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Standard": {
      "PermitLimit": 200,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Export": {
      "PermitLimit": 50,
      "Window": "00:05:00",
      "SegmentsPerWindow": 10,
      "QueueLimit": 0
    }
  }
}
